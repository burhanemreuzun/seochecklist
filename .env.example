# ---- Sunucu ----
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seochecklist

# ---- Giriş ----
# Parolayı elle yazma; şu komut scrypt özetini üretip buraya yazar:
#   npm run set-password "parolan"
# Aynı komut SESSION_SECRET yoksa rastgele üretir.
APP_PASSWORD_HASH=
SESSION_SECRET=

# ---- Gemini (yapay zekâ kontrolü) ----
# https://aistudio.google.com/apikey adresinden alınır.
# Boş bırakılırsa yapay zekâ maddeleri atlanır, kural motoru yine çalışır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ---- Denetleyici ----
# Sayfa çekilirken kullanılacak User-Agent ve zaman aşımı (milisaniye)
FETCH_TIMEOUT_MS=20000
FETCH_USER_AGENT=SEOChecklistBot/1.0 (+https://github.com/burhanemreuzun/seochecklist)
