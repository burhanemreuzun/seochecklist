# ---- Sunucu ----
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seochecklist

# ---- Gemini (AI kontrol) ----
# https://aistudio.google.com/apikey adresinden alinir.
# Bos birakilirsa AI kontrolleri atlanir, kural motoru yine calisir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ---- Denetleyici ----
# Sayfa cekerken kullanilacak User-Agent ve zaman asimi (ms)
FETCH_TIMEOUT_MS=20000
FETCH_USER_AGENT=SEOChecklistBot/1.0 (+https://github.com/burhanemreuzun/seochecklist)
