{
  "name": "seochecklist",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress yazilari icin yayin oncesi SEO kontrol listesi - kural motoru + Gemini destekli otomatik denetim",
  "scripts": {
    "setup": "npm install && npm run db:setup",
    "db:setup": "node server/src/db/migrate.js && node server/src/db/seed.js",
    "db:seed": "node server/src/db/seed.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "hosting:build": "npm install && npm run build",
    "start": "node server/src/index.js",
    "check": "node server/src/cli.js",
    "set-password": "node server/src/set-password.js"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
